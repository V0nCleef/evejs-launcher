{
  "schemaVersion": 3,
  "id": "native-startup-demo",
  "displayName": "Native Startup Example",
  "version": "1.0.0",
  "description": "Records an EveJS package generation before startup; no gameplay or source patches.",
  "kind": "loader",
  "supportedBackends": ["native"],
  "activation": {"strategy": "loader_rename"},
  "restart": "game_server",
  "launcherApi": {
    "version": 1,
    "minLauncherVersion": "1.0.74",
    "helper": {"runtime": "node", "path": "helper.js"},
    "capabilities": ["prepare_server_start"]
  },
  "settings": {
    "schemaVersion": 1,
    "files": [{"id": "options", "base": "evejs", "path": "config/native-startup-demo.json", "format": "json"}],
    "fields": [{"id": "label", "label": "Example label", "type": "string", "default": "Pilot", "file": "options", "key": ["label"]}]
  }
}
